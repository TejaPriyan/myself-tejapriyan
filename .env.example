# ============================================================
# Glass-Tech Sanctuary 2026 — Environment Variables
# Copy this file to `.env` and fill in your keys.
# All variables are OPTIONAL — the app runs without any keys,
# but AI chat & image generation need at least one provider.
# ============================================================

# Server port (default: 3000)
PORT=3000

# --- AI Chat (Ami) -------------------------------------------
# Provider priority: OpenRouter → Groq → Gemini → Hugging Face → Pollinations → local fallback

# OpenRouter key (primary; free models tried first)
OPENROUTER_API_KEY=

# Groq key (fallback #2)
GROQ_API_KEY=

# Google Gemini key (fallback #3) — any of these three names works
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Hugging Face token (fallback #4)
HF_TOKEN=
# HUGGINGFACE_API_KEY=

# Pollinations key (fallback #5, also used for images)
POLLINATIONS_API_KEY=

# --- Image Generation -----------------------------------------
# Priority: Magnific Flux 2 Pro → Cloudflare Worker → Pollinations

# Magnific API key (primary)
MAGNIFIC_API_KEY=

# Cloudflare Worker endpoint + key (fallback #2)
CF_IMAGE_API_URL=
CF_IMAGE_API_KEY=

# --- Deployment ------------------------------------------------
# Public URL of the deployed app (used as the OpenRouter HTTP-Referer)
RENDER_EXTERNAL_URL=
